{
  "name": "script-shelf",
  "version": "0.1.3",
  "private": true,
  "type": "module",
  "description": "Manual JavaScript script manager for Chrome tabs",
  "scripts": {
    "build": "npm run typecheck && rollup -c",
    "typecheck": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run lint && npm run build && npm test",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "test:ui": "node tests/ui.smoke.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-typescript": "^12.3.0",
    "@stylistic/eslint-plugin": "^5.10.0",
    "@types/chrome": "^0.1.0",
    "@types/node": "^24.0.0",
    "eslint": "^10.12.0",
    "eslint-plugin-svelte": "^3.23.0",
    "globals": "^17.13.0",
    "playwright": "^1.64.0",
    "rollup": "^4.64.1",
    "rollup-plugin-svelte": "^7.2.3",
    "svelte": "^5.57.2",
    "svelte-check": "^4.7.6",
    "tslib": "^2.8.1",
    "tsx": "^4.20.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.1"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "codeflask": "1.4.1"
  }
}
