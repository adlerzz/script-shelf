{
  "manifest_version": 3,
  "name": "Script Shelf",
  "version": "0.1.2",
  "description": "Organize and manually run your JavaScript snippets on the current tab.",
  "minimum_chrome_version": "135",
  "permissions": ["storage", "userScripts", "activeTab"],
  "host_permissions": ["http://*/*", "https://*/*", "file:///*"],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Script Shelf",
    "default_icon": {
      "16": "icons/16.png",
      "32": "icons/32.png"
    }
  },
  "options_ui": {
    "page": "manager.html",
    "open_in_tab": true
  },
  "icons": {
    "16": "icons/16.png",
    "48": "icons/48.png",
    "128": "icons/128.png"
  }
}
